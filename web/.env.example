# Optional. Keep actual keys in .env (local) or Sites secrets (hosted).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Real cards only. Sandbox is intentionally rejected.
PLAID_ENV=production
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate once: openssl rand -base64 32. Keep stable; changing it makes saved tokens unreadable.
PLAID_TOKEN_ENCRYPTION_KEY=
# Allowlist this exact HTTPS URL in Plaid Dashboard > Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=
